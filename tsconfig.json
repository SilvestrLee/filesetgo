{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*.ts", "vite.config.js"],
    "exclude": ["resources/js/quick-fit/tests/**", "resources/js/presets/tests/**", "resources/js/logo-pack/tests/**"]
}
